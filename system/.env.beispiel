# Kopieren nach .env und ausfüllen. Alles ist optional – ohne diese Werte
# läuft das System im lokalen Modus (E-Mails landen im Postausgang des
# Dashboards, Zahlungen laufen als Überweisung).

# Port des Servers
PORT=3000

# Öffentliche Adresse der Website (für Links in E-Mails und Stripe)
BASIS_URL=http://localhost:3000

# SMTP-Zugang für echten E-Mail-Versand (z. B. vom Hoster oder web.de)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ABSENDER="Wertacher Mühle <Wertachermuehle@web.de>"

# Stripe für Online-Zahlung (https://dashboard.stripe.com/apikeys)
# Ohne Schlüssel wird bei Buchungen automatisch auf Überweisung umgestellt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
